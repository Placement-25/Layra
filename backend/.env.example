# LAYRA Backend Configuration
PROJECT_NAME="LAYRA Reasoning Platform"
API_V1_STR="/api/v1"
SECRET_KEY="replace-this-with-a-secure-random-secret-key"

# CORS Origins (Comma-separated)
BACKEND_CORS_ORIGINS=["http://localhost:3000","https://layra.vercel.app"]

# PostgreSQL Connection
POSTGRES_SERVER=localhost
POSTGRES_USER=layra_user
POSTGRES_PASSWORD=layra_secure_password
POSTGRES_DB=layra_db
POSTGRES_PORT=5432

# ChromaDB Vector Store
CHROMA_HOST=localhost
CHROMA_PORT=8000

# LLM Providers
GEMINI_API_KEY=your-gemini-api-key-here
OPENAI_API_KEY=optional-openai-key-here
